APP_NAME=Kiray
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.et
APP_TIMEZONE=Africa/Addis_Ababa

APP_LOCALE=am
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kiray
DB_USERNAME=kiray
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# SMS: set to afromessage with your account values before inviting pilots.
SMS_DRIVER=log
AFROMESSAGE_TOKEN=
AFROMESSAGE_BASE_URL=https://api.afromessage.com/api
AFROMESSAGE_IDENTIFIER_ID=
AFROMESSAGE_SENDER=

# Telegram bot (optional). After setting, run: php artisan telegram:set-webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# SMS price per segment in santim (shows announcement cost). Optional.
SMS_PRICE_PER_SEGMENT_SANTIM=

# Chapa online rent (phase 2). Needs a merchant account (trade license + TIN).
# Webhook URL to set in the Chapa dashboard: https://<your-domain>/api/chapa/webhook
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_PLATFORM_FEE_SANTIM=2500

# Push notifications (Firebase service account JSON); leave empty to keep push off
FCM_CREDENTIALS=
