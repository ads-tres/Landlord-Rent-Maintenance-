APP_NAME=Kiray
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=am
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL in production (host must be physically in Ethiopia, Proclamation 1321/2024).
# For quick local development you can use DB_CONNECTION=sqlite instead.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kiray
DB_USERNAME=kiray
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=Africa/Addis_Ababa

# SMS: "log" writes codes to storage/logs/laravel.log; "afromessage" sends real SMS.
SMS_DRIVER=log
AFROMESSAGE_TOKEN=
AFROMESSAGE_BASE_URL=https://api.afromessage.com/api
AFROMESSAGE_IDENTIFIER_ID=
AFROMESSAGE_SENDER=

# Telegram bot (optional): free messages for linked landlords and tenants, SMS otherwise.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# SMS price per segment in santim (shows announcement cost). Optional.
SMS_PRICE_PER_SEGMENT_SANTIM=

# Chapa online rent (phase 2). Needs a merchant account (trade license + TIN).
# Webhook URL to set in the Chapa dashboard: https://<your-domain>/api/chapa/webhook
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_PLATFORM_FEE_SANTIM=2500

# Push notifications: path to the Firebase service account JSON (leave empty to turn push off)
FCM_CREDENTIALS=
